public class Controller {
  enum Key {
    LEFT(KEY_LEFT),
    RIGHT(KEY_RIGHT),
    UP(KEY_UP),
    DOWN(KEY_DOWN);

    private final int raylibCode;

    Key(int raylibCode) {
      this.raylibCode = raylibCode;
    }
  }

  /** Speed while an arrow key is held, in pixels per second. */
  private static final float SPEED = 200f;

  private final Model model;

  private Consumer<Set<Key>> heldKeysListener = heldKeys -> {};

  public Controller(Model model) {
    this.model = model;
    this.heldKeysListener = this::move;
  }

  private void move(Set<Key> heldKeys) {
    float x = direction(heldKeys, Key.LEFT, Key.RIGHT);
    float y = direction(heldKeys, Key.UP, Key.DOWN);
    model.setVelocity(new Velocity(x * SPEED, y * SPEED));
  }

  /** Returns -1, 0 or 1, so holding both keys or neither gives 0. */
  private static float direction(Set<Key> heldKeys, Key negative, Key positive) {
    float direction = 0;
    if (heldKeys.contains(negative)) {
      direction -= 1;
    }
    if (heldKeys.contains(positive)) {
      direction += 1;
    }
    return direction;
  }

  public void update() {
    processInput();
  }

  private void processInput() {
    Set<Key> heldKeys = EnumSet.noneOf(Key.class);
    for (Key key : Key.values()) {
      if (IsKeyDown(key.raylibCode)) {
        heldKeys.add(key);
      }
    }
    heldKeysListener.accept(heldKeys);
  }
}
